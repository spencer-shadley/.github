{
  "schemaId": "https://schemas.repo-template.dev/local-ci-v3/local-ci-contract-v3.schema.json",
  "schemaVersion": "3.0.0",
  "contractId": "repo-template/local-ci-v3",
  "repository": "spencer-shadley/.github",
  "canonicalBranch": "main",
  "prMergeProfileId": "merge",
  "prBroaderFallback": true,
  "prReceiptBindsCandidate": true,
  "prReceiptBindsBase": true,
  "prReceiptBindsIntegration": true,
  "prReceipt": {
    "bindsCandidate": true,
    "bindsBase": true,
    "bindsIntegration": true
  },
  "fullRequiredLegIds": [
    "default"
  ],
  "commands": {
    "consumer-pin-gate": {
      "name": "consumer-pin-gate",
      "executable": "node",
      "args": [
        "--experimental-strip-types",
        "contracts/governed-intake-consumer-pin.gate.ts"
      ],
      "shell": "none",
      "cwd": ".",
      "timeoutSeconds": 300,
      "expectedExitCode": 0,
      "failureDisposition": "fail-gate",
      "detectionProof": {
        "exempt": "Runs at the exact PR head before any merge effect (spencer-shadley/code#8036). A PR that changes none of contracts/generated/governed-intake/**, contracts/governed-intake-body.v1.json or .github/ISSUE_TEMPLATE/task.yml passes offline with no reads. A release-touching PR exits 0 only when Code master and the deployed github-mcp-worker both admit its release; refusal exits 1 and an unreadable input exits 2. test/consumer-pin-gate.test.ts replays .github#40, #43 and #55 through this entrypoint."
      }
    },
    "authoritative-gate": {
      "name": "verify",
      "executable": "node",
      "args": [
        "--experimental-strip-types",
        "--test",
        "test/*.test.ts"
      ],
      "shell": "none",
      "cwd": ".",
      "timeoutSeconds": 600,
      "expectedExitCode": 0,
      "failureDisposition": "fail-gate",
      "detectionProof": {
        "exempt": "node --test exits non-zero when any test fails; test/published-release.test.ts fails when released payload bytes differ from the published manifest (.github#43); test/consumer-pin-admission.test.ts fails when recorded worker pins refuse a release (spencer-shadley/code#8013, replaying .github#40 and #43)."
      }
    }
  },
  "environment": {
    "runtime": {
      "name": "node",
      "versionConstraint": ">=24.0.0"
    },
    "packageManager": {
      "name": "none",
      "version": "0"
    },
    "supportedPlatforms": [
      "win32",
      "linux",
      "darwin"
    ],
    "supportedArchitectures": [
      "x64",
      "arm64"
    ],
    "requiredEnvVars": [],
    "requiredCredentials": [],
    "networkExpectation": "outbound-allowed"
  },
  "effects": {
    "credentialsAccess": true,
    "networkProviderAccess": false,
    "providerSpend": false,
    "externalMutation": false,
    "registrationMutation": false,
    "schedulesMutation": false,
    "deploymentMutation": false,
    "consumerBindingMutation": false,
    "servingAuthorityMutation": false
  }
}
